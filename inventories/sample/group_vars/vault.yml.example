---
# Copy this file to vault.yml and encrypt it with ansible-vault.
# Replace every CHANGE_ME value before execution.

# REQUIRED inputs consumed by the installer.
vault_pull_secret: '{"auths":{"cloud.openshift.com":{"auth":"CHANGE_ME"},"registry.redhat.io":{"auth":"CHANGE_ME"}}}'
vault_ssh_public_key: "ssh-ed25519 CHANGE_ME"

# REQUIRED for assisted_auth_mode=saas.
vault_assisted_offline_token: "CHANGE_ME_RED_HAT_OFFLINE_TOKEN"

# REQUIRED for assisted_auth_mode=onprem instead of assisted_offline_token.
# vault_assisted_access_token: "CHANGE_ME_ON_PREMISES_TOKEN"

# REQUIRED: Passwords are keyed by Ansible inventory hostname.
vault_bmc_credentials:
  master-0: {username: Administrator, password: CHANGE_ME_ILO_PASSWORD}
  master-1: {username: root, password: CHANGE_ME_IDRAC_PASSWORD}
  master-2: {username: CHANGE_ME_BMC_USER, password: CHANGE_ME_BMC_PASSWORD}
  worker-0: {username: Administrator, password: CHANGE_ME_ILO_PASSWORD}
  worker-1: {username: root, password: CHANGE_ME_IDRAC_PASSWORD}

# Optional. When omitted, oc-mirror uses vault_pull_secret as its auth file.
# vault_mirror_auth_json: '{"auths":{"registry.example.com:8443":{"auth":"CHANGE_ME"}}}'

# Optional Day-2 Git write/bootstrap credentials. Prefer a short-lived token
# scoped to the desired-state repository, or an SSH deploy key.
# vault_git_username: "oauth2"
# vault_git_token: "CHANGE_ME_GIT_TOKEN"
# vault_git_ssh_private_key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   CHANGE_ME
#   -----END OPENSSH PRIVATE KEY-----
