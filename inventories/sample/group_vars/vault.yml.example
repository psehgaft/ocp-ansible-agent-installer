---
# Copy this file to vault.yml and encrypt it with ansible-vault.
# Replace every CHANGE_ME value before execution.

# REQUIRED for assisted_auth_mode=saas.
assisted_offline_token: "CHANGE_ME_RED_HAT_OFFLINE_TOKEN"

# REQUIRED for assisted_auth_mode=onprem instead of assisted_offline_token.
# assisted_access_token: "CHANGE_ME_ON_PREMISES_TOKEN"

# REQUIRED: Passwords are keyed by Ansible inventory hostname.
vault_bmc_passwords:
  master-0: "CHANGE_ME_ILO_PASSWORD"
  master-1: "CHANGE_ME_IDRAC_PASSWORD"
  master-2: "CHANGE_ME_BMC_PASSWORD"
  worker-0: "CHANGE_ME_ILO_PASSWORD"
  worker-1: "CHANGE_ME_IDRAC_PASSWORD"
