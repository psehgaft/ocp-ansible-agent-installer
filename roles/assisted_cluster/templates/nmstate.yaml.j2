interfaces:
{% if install_network_mode == 'bond' %}
  - name: {{ install_network_bond_name }}
    type: bond
    state: up
    mtu: {{ install_network_mtu | int }}
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: "{{ hostvars[target_host].node_ipv4_address }}"
          prefix-length: {{ node_ipv4_prefix | int }}
    ipv6:
      enabled: false
    link-aggregation:
      mode: {{ install_network_bond_mode }}
      options:
        miimon: "100"
      port:
{% for port in install_network_bond_ports %}
        - {{ port }}
{% endfor %}
{% else %}
  - name: {{ install_network_interface }}
    type: ethernet
    state: up
    mtu: {{ install_network_mtu | int }}
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: "{{ hostvars[target_host].node_ipv4_address }}"
          prefix-length: {{ node_ipv4_prefix | int }}
    ipv6:
      enabled: false
{% endif %}

dns-resolver:
  config:
    server:
{% for server in node_dns_servers %}
      - "{{ server }}"
{% endfor %}

routes:
  config:
    - destination: 0.0.0.0/0
      next-hop-address: "{{ node_ipv4_gateway }}"
      next-hop-interface: "{{ install_network_bond_name if install_network_mode == 'bond' else install_network_interface }}"
