# Generated by Ansible for {{ item.metadata.name }}
apiVersion: project.openshift.io/v1
kind: Project
metadata:
  name: "{{ item.metadata.name }}"
  annotations:
    openshift.io/display-name: "{{ item.metadata.name }}"
    openshift.io/description: "Namespace for cluster {{ item.metadata.name }}"
  labels:
    environment: "{{ item.labels.environment | default(item.metadata.name) }}"
    team: "{{ item.labels.team | default('kubernetes') }}"
---
apiVersion: hive.openshift.io/v1
kind: ClusterDeployment
metadata:
  name: {{ item.metadata.name }}
  namespace: {{ item.metadata.name }}
  labels:
    cloud: vSphere
    vendor: OpenShift
    cluster.open-cluster-management.io/clusterset: {{ item.acm.clusterset | default('default') }}
spec:
  baseDomain: {{ item.baseDomain }}
  clusterName: {{ item.metadata.name }}
  controlPlaneConfig:
    servingCertificates: {}
  installAttemptsLimit: {{ item.hive.installAttemptsLimit | default(1) }}
  installed: false
  platform:
    vsphere:
      cluster: {{ item.hive.vsphere.cluster }}
      certificatesSecretRef:
        name: {{ item.metadata.name }}-vsphere-certs
      credentialsSecretRef:
        name: {{ item.metadata.name }}-vsphere-creds
      vCenter: {{ item.hive.vsphere.vcenter | default(item.platform.vsphere.vcenters[0].server) }}
      datacenter: {{ item.hive.vsphere.datacenter }}
      defaultDatastore: {{ item.hive.vsphere.defaultDatastore }}
      network: {{ item.hive.vsphere.network }}
      folder: {{ item.hive.vsphere.folder }}
  provisioning:
    installConfigSecretRef:
      name: {{ item.metadata.name }}-install-config
    sshPrivateKeySecretRef:
      name: {{ item.metadata.name }}-ssh-private-key
    imageSetRef:
      name: {{ item.hive.imageSetRef }}
  pullSecretRef:
    name: {{ item.metadata.name }}-pull-secret
---
apiVersion: cluster.open-cluster-management.io/v1
kind: ManagedCluster
metadata:
  name: {{ item.metadata.name }}
  labels:
    name: {{ item.metadata.name }}
    cloud: vSphere
    vendor: OpenShift
    cluster.open-cluster-management.io/clusterset: {{ item.acm.clusterset | default('default') }}
spec:
  hubAcceptsClient: true
---
apiVersion: hive.openshift.io/v1
kind: MachinePool
metadata:
  name: {{ item.metadata.name }}-worker
  namespace: {{ item.metadata.name }}
spec:
  name: {{ (item.compute[0].name if item.compute is defined and item.compute|length>0 else 'worker') }}
  clusterDeploymentRef:
    name: {{ item.metadata.name }}
  platform:
    vsphere:
      cpus: {{ item.compute[0].platform.vsphere.cpus }}
      coresPerSocket: {{ item.compute[0].platform.vsphere.coresPerSocket }}
      memoryMB: {{ item.compute[0].platform.vsphere.memoryMB }}
      osDisk:
        diskSizeGB: {{ item.compute[0].platform.vsphere.osDisk.diskSizeGB }}
  replicas: {{ item.compute[0].replicas }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ item.metadata.name }}-pull-secret
  namespace: {{ item.metadata.name }}
stringData:
  .dockerconfigjson: |-
    {{ item.pullSecret | indent(4) }}
type: kubernetes.io/dockerconfigjson
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ item.metadata.name }}-install-config
  namespace: {{ item.metadata.name }}
type: Opaque
data:
  install-config.yaml: >-
    {{ lookup('file', playbook_dir + '/output/' + item.metadata.name + '/install-config.yaml') | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ item.metadata.name }}-ssh-private-key
  namespace: {{ item.metadata.name }}
stringData:
  ssh-privatekey: |-
    {{ item.secrets.sshPrivateKey | indent(4) }}
type: Opaque
---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ item.metadata.name }}-vsphere-creds
  namespace: {{ item.metadata.name }}
stringData:
  username: {{ item.hive.vsphere.credentials.username }}
  password: {{ item.hive.vsphere.credentials.password }}
---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ item.metadata.name }}-vsphere-certs
  namespace: {{ item.metadata.name }}
data:
  .cacert: >-
    {{ (item.hive.vsphere.cacert | b64encode) if (item.hive.vsphere.cacert is defined) else '' }}
---
apiVersion: agent.open-cluster-management.io/v1
kind: KlusterletAddonConfig
metadata:
  name: {{ item.metadata.name }}
  namespace: {{ item.metadata.name }}
spec:
  clusterName: {{ item.metadata.name }}
  clusterNamespace: {{ item.metadata.name }}
  clusterLabels:
    cloud: vSphere
    vendor: OpenShift
  applicationManager:
    proxyPolicy: {{ item.klusterlet.proxyPolicy | default('OCPGlobalProxy') }}
    enabled: {{ item.klusterlet.applicationManager.enabled | default(true) | ternary('true','false') }}
  policyController:
    proxyPolicy: {{ item.klusterlet.proxyPolicy | default('OCPGlobalProxy') }}
    enabled: {{ item.klusterlet.policyController.enabled | default(true) | ternary('true','false') }}
  searchCollector:
    proxyPolicy: {{ item.klusterlet.proxyPolicy | default('OCPGlobalProxy') }}
    enabled: {{ item.klusterlet.searchCollector.enabled | default(true) | ternary('true','false') }}
  certPolicyController:
    proxyPolicy: {{ item.klusterlet.proxyPolicy | default('OCPGlobalProxy') }}
    enabled: {{ item.klusterlet.certPolicyController.enabled | default(true) | ternary('true','false') }}
  iamPolicyController:
    proxyPolicy: {{ item.klusterlet.proxyPolicy | default('OCPGlobalProxy') }}
    enabled: {{ item.klusterlet.iamPolicyController.enabled | default(true) | ternary('true','false') }}
