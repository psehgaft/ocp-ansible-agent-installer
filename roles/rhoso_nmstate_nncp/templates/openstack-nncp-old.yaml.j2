{% for node in rhoso_worker_nodes %}
apiVersion: nmstate.io/v1
kind: NodeNetworkConfigurationPolicy
metadata:
  name: osp-net-{{ node }}
spec:
  nodeSelector:
    kubernetes.io/hostname: {{ node }}
    {{ rhoso_worker_label_key }}: ""
  desiredState:
    {% if rhoso_dns_nameservers is defined and (rhoso_dns_nameservers | length) > 0 %}
    dns-resolver:
      config:
        server:
{% for ns in rhoso_dns_nameservers %}
          - {{ ns }}
{% endfor %}
    {% endif %}
    interfaces:
      - name: eno1
        type: ethernet
        state: up
        mtu: 9000
      - name: eno2
        type: ethernet
        state: up
        mtu: 9000
      - name: eno3
        type: ethernet
        state: up
        mtu: 9000
      - name: eno4
        type: ethernet
        state: up
        mtu: 9000

      - name: bond0
        type: bond
        state: up
        mtu: 9000
        bond:
          mode: 802.3ad
          miimon: 100
          min_links: 1
          members:
            - eno1
            - eno2
      
      - name: br-ex
        type: ovs-bridge
        state: up
        mtu: 9000
        bridge:
          interfaces:
            - bond0
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: {{ hostvars[target_host].node_ipv4_address }}
              prefix-length: {{ hostvars[target_host].node_ipv4_prefix | int }}
        ipv6:
          enabled: false

{% for net in rhoso_isolated_networks %}
      - name: {{ net.name }}
        description: "{{ net.name }} VLAN interface"
        type: vlan
        state: up
        mtu: {{ net.mtu }}
        vlan:
          base-iface: {{ rhoso_isolated_base_iface }}
          id: {{ net.vlan_id }}
          reorder-headers: true
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: {{ ocp_worker_node_ips[node][net.name] }}
              prefix-length: {{ net.prefix_length }}
        ipv6:
          enabled: false
{% endfor %}
{% for net in rhoso_storage_networks %}
      - name: {{ net.name }}
        description: "{{ net.name }} VLAN interface"
        type: vlan
        state: up
        mtu: {{ net.mtu }}
        vlan:
          base-iface: {{ rhoso_isolated_base_iface }}
          id: {{ net.vlan_id }}
          reorder-headers: true
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: {{ ocp_worker_node_ips[node][net.name] }}
              prefix-length: {{ net.prefix_length }}
        ipv6:
          enabled: false
{% endfor %}
---
{% endfor %}
